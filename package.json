{
  "name": "ultimate-test",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright TypeScript suite for ADAD: page objects, TestPoints, and tests/",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "CHOKIDAR_USEPOLLING=1 playwright test --ui",
    "test:smoke": "playwright test tests/smoke",
    "test:filters": "playwright test tests/filters",
    "test:navigation": "playwright test tests/navigation",
    "test:testpoints": "playwright test tests/testpoints",
    "report": "playwright show-report reports/latest/html",
    "pack:execution": "node scripts/pack-execution.js",
    "codegen": "playwright codegen"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "@types/ssh2-sftp-client": "^9.0.4",
    "dotenv": "^16.4.7",
    "pg": "^8.13.3",
    "ssh2-sftp-client": "^11.0.0",
    "typescript": "^5.8.2",
    "yaml": "^2.7.0"
  }
}
